{
  "name": "xcoretech-disk-cleaner",
  "version": "1.3.32",
  "description": "Advanced PC optimizer and cleaner built with Electron",
  "main": "index.js",
  "author": "XCoreTech Team",
  "license": "Proprietary",
  "private": true,
  "scripts": {
    "start": "electron . --js-flags=\"--max-old-space-size=96 --optimize-for-size --gc-interval=100 --expose-gc\" --disable-gpu-sandbox",
    "pack": "electron-builder --dir",
    "predist": "node pre-dist.js",
    "dist": "electron-builder",
    "prerelease": "node pre-dist.js",
    "release": "electron-builder --publish always",
    "test": "playwright test",
    "test:stress": "playwright test tests/stress.spec.js",
    "test:ci": "playwright test tests/platform.spec.js tests/static-contracts.spec.js tests/core.spec.js tests/dashboard.spec.js tests/full-version.spec.js tests/ipc-ui-extra.spec.js tests/ui-structure-extra.spec.js tests/update.spec.js tests/large-files.spec.js tests/dev-caches.spec.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "electron": "22.3.27",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.xcoretech.diskcleaner",
    "productName": "XCoreTech PC Optimizer",
    "publish": {
      "provider": "github",
      "owner": "mhmdrameez",
      "repo": "xcoretechelectron",
      "private": false
    },
    "releaseInfo": {
      "releaseNotesFile": "release-notes.md"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.js",
      "main.js",
      "preload.js",
      "renderer.js",
      "scanner.js",
      "cleaner.js",
      "utils.js",
      "startupItems.js",
      "platform.js",
      "systemInfo.js",
      "analytics.js",
      "crashHandler.js",
      "location.js",
      "updater.js",
      "technician.js",
      "largeFiles.js",
      "devCaches.js",
      "index.html",
      "styles.css",
      "assets/**/*"
    ],
    "asar": true,
    "compression": "maximum",
    "win": {
      "icon": "assets/app-icon.ico",
      "verifyUpdateCodeSignature": false,
      "requestedExecutionLevel": "asInvoker",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "ia32",
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "XCoreTech PC Optimizer",
      "deleteAppDataOnUninstall": true,
      "license": "license.txt",
      "include": "installer/installer.nsh"
    },
    "afterPack": "installer/after-pack.js",
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "assets/icon-1024.png",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "XCoreTech-PC-Optimizer-${version}-mac-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "assets/icon-1024.png",
      "category": "Utility",
      "executableName": "xcoretech-pc-optimizer",
      "maintainer": "XCoreTech Team <mhmdrameez@users.noreply.github.com>",
      "synopsis": "Clean junk files, find large files and tidy developer caches",
      "artifactName": "XCoreTech-PC-Optimizer-${version}-linux-${arch}.${ext}",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.3"
  },
  "allowScripts": {
    "electron@22.3.27": true
  }
}
